{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may use the core APIs, read and write the library folder, and save exports the student picks.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    },
    {
      "identifier": "fs:allow-unwatch",
      "allow": [{ "path": "$HOME/BetterNotez Library" }, { "path": "$HOME/BetterNotez Library/**" }]
    }
  ]
}
