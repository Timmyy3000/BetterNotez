{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterNotez",
  "version": "0.1.0",
  "identifier": "app.betternotez",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BetterNotez",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A free, open-source study app for lecture PDFs.",
    "longDescription": "BetterNotez keeps lecture PDFs organized by subject, with text boxes, freehand ink, a notepad per lecture, a weekly planner, and a task board. Your library is a folder on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
